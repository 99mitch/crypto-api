# ===== SERVER =====
PORT=3000
NODE_ENV=development

# ===== MONGODB =====
MONGODB_URI=mongodb://localhost:27017/crypto-pay

# ===== TRON =====
# Clé API TronGrid (gratuit sur https://www.trongrid.io/)
TRONGRID_API_KEY=ea315eda-36de-445d-94ce-781e2de124e1

# Adresse de ton wallet central (où les fonds seront sweep)
CENTRAL_WALLET_ADDRESS=TXxxxxxxxxxxxxxxxxxxxxxxxxxxx
CENTRAL_WALLET_PRIVATE_KEY=your-central-wallet-private-key

# Réseau: mainnet ou shasta (testnet)
TRON_NETWORK=shasta
TRON_FULL_HOST=https://api.shasta.trongrid.io
# Pour mainnet: https://api.trongrid.io

# Adresse du contrat USDT TRC-20
# Mainnet: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Shasta (test USDT): TG3XXyExBkPp9nzdajDZsozEu4BkaSJozs
USDT_CONTRACT_ADDRESS=TG3XXyExBkPp9nzdajDZsozEu4BkaSJozs

# ===== PAIEMENTS =====
PAYMENT_EXPIRATION_MINUTES=15
PAYMENT_CHECK_INTERVAL_SECONDS=10
# Tolérance sur le montant reçu (0.015 = 1.5%)
PAYMENT_AMOUNT_TOLERANCE=0.015
# Délai de grâce après expiration pour accepter un paiement tardif (en secondes)
PAYMENT_GRACE_PERIOD_SECONDS=120

# ===== WEBHOOK =====
WEBHOOK_INTERNAL_URL=http://localhost:3000/api/internal/payment-confirmed
WEBHOOK_SECRET=your-webhook-secret-key

# ===== SWEEP =====
# Montant minimum TRX requis pour le gas du sweep (en SUN)
SWEEP_MIN_TRX_FOR_GAS=15000000
# Fee limit pour les transactions TRC-20 (en SUN)
SWEEP_FEE_LIMIT=30000000

# ===== FRAIS =====
# Wallet recevant les frais de plateforme
FEES_WALLET_ADDRESS=TXxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pourcentage prélevé sur chaque paiement (0.03 = 3%)
FEES_PERCENTAGE=0.03

# ===== SÉCURITÉ =====
# Clé de chiffrement AES-256 pour les clés privées (générer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ===== ADMIN =====
# Clé API pour accéder aux endpoints admin
ADMIN_API_KEY=your-admin-api-key
# Mot de passe pour le login dashboard
ADMIN_PASSWORD=your-secure-admin-password
# Secret pour signer les tokens admin
ADMIN_TOKEN_SECRET=your-admin-token-secret
